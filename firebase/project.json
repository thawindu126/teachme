{
  "name": "firebase",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "firebase/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@simondotm/nx-firebase:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/firebase",
        "main": "firebase/src/index.ts",
        "tsConfig": "firebase/tsconfig.app.json",
        "packageJson": "firebase/package.json",
        "assets": []
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run firebase:build && nx watch --projects=firebase --includeDependentProjects -- nx build firebase --clean=false",
          "nx run firebase:emulate"
        ]
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["firebase/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "firebase/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "firebase deploy --config firebase.json --project teachme"
      }
    },
    "getconfig": {
      "executor": "nx:run-commands",
      "options": {
        "command": "firebase functions:config:get --config firebase.json --project teachme > firebase/.runtimeconfig.json"
      }
    },
    "emulate": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node -e 'setTimeout(()=>{},5000)'",
          "kill-port --port 9099,5001,8080,9000,5000,8085,9199,9299,4000,4400,4500",
          "firebase functions:config:get  --config firebase.json --project teachme > dist/firebase/.runtimeconfig.json",
          "firebase emulators:start  --config firebase.json --project teachme"
        ],
        "parallel": false
      }
    }
  },
  "tags": []
}
